# ============================================= #
# NEXUS ESPORTS WHATSAPP BOT — CONFIGURATION    #
# ============================================= #
# Copy this file to .env and customize.
# BOT WORKS BOTH LOCALLY AND IN PRODUCTION.
#
# NEXUS_API_URL is AUTO-DETECTED from NODE_ENV:
#   NODE_ENV=development → http://localhost:3000/api
#   NODE_ENV=production  → https://nexusesportshub.vercel.app/api
# You only need to set NEXUS_API_URL explicitly if you
# want to override the auto-detection.
# ============================================= #

# Bot name (used in logs and responses)
BOT_NAME=NexusBot

# Logging level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Directory to store WhatsApp session/auth data
WHATSAPP_SESSION_DIR=./sessions

# HTTP port for the health check server
PORT=3001

# Comma-separated WhatsApp Group JIDs the bot is allowed to respond in
# EXAMPLE: 120363123456789@g.us,120363987654321@g.us
# Leave empty to only respond in DMs
WHATSAPP_GROUP_JIDS=

# Comma-separated WhatsApp JIDs of bot administrators
# EXAMPLE: 254712345678@s.whatsapp.net,254798765432@s.whatsapp.net
ADMIN_JIDS=

# Nexus Esports platform API base URL
# ⚡ AUTO-DETECTED from NODE_ENV — only set this to override:
#   development: http://localhost:3000/api
#   production:  https://nexusesportshub.vercel.app/api
# NEXUS_API_URL=

# Shared secret for authenticating with the Nexus API
# Must match NEXUS_API_SECRET in the Nexus platform's .env.local
# ⚡ DEFAULT for development: 4a2bfa6ef184b1c4c686fadcb407ef05ff9276a25045550b5aeaa4121f3c7144
# NEXUS_API_SECRET=

# Secret for verifying incoming webhooks from Nexus
WEBHOOK_SECRET=XNyBPzdOi/+jKbv5GsnOqLacRx6Hq4O+dQsY2jbxACg=

# Node environment — automatically set to "production" on Render
NODE_ENV=development
